# Form delivery (Request a quote + Contact). Copy to .env.local.
# Without RESEND_API_KEY, `next dev` prints submissions to the terminal and production returns an error.
RESEND_API_KEY=
# Verified sender on your Resend domain.
FORMS_FROM="Farasha POS Solutions <forms@farashapos.com>"
# Where submissions go. Defaults: quotes@farashapos.com and contactus@farashapos.com.
QUOTES_TO=
CONTACT_TO=

# Donations page: hosted payment link for each donation type (Stripe Payment Link, PayPal, Zeffy…).
# A type left empty sends donors to the contact form instead.
NEXT_PUBLIC_DONATE_GENERAL_URL=
NEXT_PUBLIC_DONATE_MONTHLY_URL=
NEXT_PUBLIC_DONATE_RESTAURANT_FUND_URL=
NEXT_PUBLIC_DONATE_TRIBUTE_URL=
