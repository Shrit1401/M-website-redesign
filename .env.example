# Frontend
# Leave empty to call same-origin Route Handlers (/api/...). Set to e.g. https://api.nebulawebtech.com
# if the backend is hosted separately (it must then allow CORS from the site's origin).
NEXT_PUBLIC_API_URL=

# Admin dashboard (/admin) — copy to .env.local and set a long, unique password.
# Without ADMIN_PASSWORD the dashboard stays locked.
ADMIN_PASSWORD=
# Optional: separate key for signing session cookies. Defaults to ADMIN_PASSWORD.
# Changing either one signs everyone out. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Backend — only needed once you follow docs/nextjs-prisma/
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nebula?schema=public"
